# Copy to .env and edit. The echo provider needs NO keys and runs out of the box.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# Which provider the app uses by default: echo | groq | gemini
DEFAULT_PROVIDER=echo

# CORS — JSON array of allowed origins (the Next.js dev server)
CORS_ORIGINS=["http://localhost:3000"]
# Also allow any localhost port in dev (Next.js falls back to :3001 when :3000 is taken)
CORS_ALLOW_LOCALHOST=true

# --- Free providers (add a key to enable, then implement the adapter) ---
GROQ_API_KEY=
GOOGLE_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Voice (Phase 2) ---
# echo = $0, no keys, silent audio (runs the whole pipeline). groq = Whisper STT (free tier,
# reuses GROQ_API_KEY). kokoro = local TTS (pip install -r requirements-voice.txt, no key).
VOICE_STT_PROVIDER=echo
VOICE_TTS_PROVIDER=echo
WHISPER_MODEL=whisper-large-v3-turbo
KOKORO_VOICE=af_heart

# --- Optional: future (paid) Claude adapter ---
# ANTHROPIC_API_KEY=
